@{
    ViewData["Title"] = "Retro";
}


<!DOCTYPE html>
<html lang="es">
<head>
    <title>(RED) Alimentación Social</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="css/styles.css">
</head>
<body class="background-index">
    <header>
        <nav class="navbar navbar-expand-lg bg-body-tertiary bg-dark p-0">
            <div class="container-fluid">
                <a class="navbar-brand text-white text-center pe-4 ps-4 pt-3 pb-3" href="#">(RED)<br>Alimentación Social</a>
            </div>
        </nav>
    </header>


    <main class="m-5">
        <div class="container text-center">
            <div class="row" id="inicioApp">
                <div class="col mb-5">
                    <img width="470px;" height="390px;"  id="originalImage" src="~/images/example-02.jpg" alt="Original Image" />
                </div>
                <div class="col video-container">
                    <video style="padding-bottom: 40px;" id="video" autoplay muted></video>
                    <img id="capturedUserImage" src="#" alt="Captured Image" style="display: none;" />
                </div>
                <h2 id="prediccion" style="display: none;">Predicción: <span id="resultado"></span></h2>
            </div>
            <div class="row" id="laPinchePrediccion" style="display: none;">
                <img id="imagenCuadrante" src="#" style="width: 500px;" alt="Prediction Image" />
            </div>
         </div>
    </main>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow/tfjs"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@tensorflow-models/coco-ssd"></script>
    <script>
        const videoWidth = 640;
        const videoHeight = 440;
        let model;
        let videoElement;
        let hasPredicted = false; // Variable para evitar múltiples predicciones


        async function loadModel() {
            model = await cocoSsd.load();
            console.log("Modelo coco-ssd cargado exitosamente.");
            startCamera(); // Asegurar que la cámara se inicie después de cargar el modelo
        }


        async function detectObjects() {
            if (hasPredicted) return; // Detener si ya se realizó una predicción
           
            const predictions = await model.detect(videoElement);
            console.log(predictions);


            if (isPersonDetected(predictions)) {
                hasPredicted = true; // Marcar que ya se hizo una predicción
                snap();
            } else {
                requestAnimationFrame(detectObjects);
            }
        }


        function isPersonDetected(predictions) {
            return predictions.some(prediction => prediction.class === "person");
        }


        function snap() {
            var canvasElement = document.createElement("canvas");
            var context = canvasElement.getContext("2d");


            canvasElement.width = videoWidth;
            canvasElement.height = videoHeight;


            context.drawImage(videoElement, 0, 0, canvasElement.width, canvasElement.height);
            var imageData = canvasElement.toDataURL('image/jpeg');
            sendForm(imageData);
        }


        function sendForm(imageData) {
            var formData = new FormData();
            formData.append("imageData", imageData);


            $.ajax({
                url: '/Retro/CaptureImage',
                type: 'POST',
                processData: false,
                contentType: false,
                data: formData,
                success: function (result) {
                    console.log("Resultado de la predicción recibido del servidor:", result);
                    var [fileName, predictedLabel] = result.split('|');
                    displayCapturedImage(fileName, predictedLabel);
                },
                error: function (xhr, status, error) {
                    console.error("Error al enviar los datos de la imagen:", error);
                }
            });
        }


        function displayCapturedImage(fileName, predictedLabel) {
            //var userImageElement = document.getElementById("capturedUserImage");
            var prediccionElement = document.getElementById("prediccion");
            var resultadoElement = document.getElementById("resultado");
            var laPinchePrediccion = document.getElementById("laPinchePrediccion");
            var inicioApp = document.getElementById("inicioApp");
            var imagenCuadrante = document.getElementById("imagenCuadrante");

            inicioApp.style.display = 'none';
            imagenCuadrante.src = /images/ + predictedLabel + '.png';
            laPinchePrediccion.style.display = 'block';

            //userImageElement.src = /images/${fileName};
            //userImageElement.style.display = 'block';

            resultadoElement.textContent = predictedLabel;
            prediccionElement.style.display = 'block';

            console.log("Imagen capturada y mostrada en pantalla.");

            setTimeout(function () {
                location.reload(); // Recargar la página después de 3 segundos
            }, 3000);
        }

        function startCamera() {
            videoElement = document.getElementById("video");
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ video: { width: videoWidth, height: videoHeight } })
                    .then(function (stream) {
                        videoElement.srcObject = stream;
                        videoElement.style.width = videoWidth + 'px';
                        videoElement.style.height = videoHeight + 'px';
                        videoElement.onloadedmetadata = function () {
                            videoElement.play();
                            console.log("Video en reproducción");
                            setTimeout(() => detectObjects(), 2000);
                            setTimeout(() => detectObjects(), 500);
                        };
                    })
                    .catch(function (error) {
                        console.error("Error al acceder a la cámara:", error);
                    });
            } else {
                console.error("getUserMedia no es compatible en este navegador.");
            }
        }


       // window.addEventListener('load', function () {
            loadModel();
//        });


    </script>


    <style>
        .container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            padding: 20px;
        }


        .image-container,
        .video-container {
            display: flex;
            justify-content: center;
            align-items: center;
        }


            .image-container img,
            .video-container video,
            .video-container img {
                width: 100%;
                height: auto;
                max-width: 100%;
                max-height: 100%;
            }


        .video-container {
            position: relative;
        }


            .video-container img {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 1;
            }
    </style>


</body>
</html>
